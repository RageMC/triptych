<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- For a free (personal) Apple ID: the only two keys of Triptych.entitlements it can sign.
     extended-virtual-addressing needs a paid account; dynamic-codesigning only TrollStore/jailbreak. -->
<dict>
	<key>get-task-allow</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
