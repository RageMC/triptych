+struct import_alias {
+    char *guest;
+    size_t guest_len;
+    char *host;
+    size_t host_len;
+};
+
+struct import_alias_list {
+    struct import_alias *items;
+    size_t count;
+    size_t cap;
+    uint64_t seq;
+    bool case_insensitive;
+};
+
 struct import_resources {
     int root_fd, entry_fd;
     sqlite3 *db;
     struct archive *archive;
+    struct import_alias_list aliases;
 };
 
+static bool import_alias_to_host(const struct import_alias_list *al, const char *guest_path, char *host_out, size_t cap) {
+    size_t guest_len = strlen(guest_path);
+    if (al->case_insensitive) {
+        const struct import_alias *best = NULL;
+        for (size_t i = 0; i < al->count; i++) {
+            const struct import_alias *a = &al->items[i];
+            if (a->guest_len == 0 || a->guest_len > guest_len)
+                continue;
+            if (memcmp(guest_path, a->guest, a->guest_len) != 0)
+                continue;
+            if (guest_path[a->guest_len] != '\0' && guest_path[a->guest_len] != '/')
+                continue;
+            if (!best || a->guest_len > best->guest_len)
+                best = a;
+        }
+        if (best) {
+            size_t tail_len = guest_len - best->guest_len;
+            size_t total = best->host_len + tail_len + 1;
+            if (total <= cap) {
+                memcpy(host_out, best->host, best->host_len);
+                memcpy(host_out + best->host_len, guest_path + best->guest_len, tail_len + 1);
+                return true;
+            }
+        }
+    }
+    if (guest_len + 1 <= cap)
+        memcpy(host_out, guest_path, guest_len + 1);
+    else if (cap > 0)
+        host_out[0] = '\0';
+    return false;
+}
+
+static bool import_alias_add(struct import_alias_list *al, const char *guest_path, const char *host_path) {
+    for (size_t i = 0; i < al->count; i++) {
+        if (strcmp(al->items[i].guest, guest_path) == 0) {
+            char *h = strdup(host_path);
+            if (!h) return false;
+            free(al->items[i].host);
+            al->items[i].host = h;
+            al->items[i].host_len = strlen(h);
+            return true;
+        }
+    }
+    if (al->count == al->cap) {
+        size_t next_cap = al->cap ? al->cap * 2 : 16;
+        struct import_alias *next = realloc(al->items, next_cap * sizeof(*next));
+        if (!next) return false;
+        al->items = next;
+        al->cap = next_cap;
+    }
+    char *g = strdup(guest_path);
+    char *h = strdup(host_path);
+    if (!g || !h) {
+        free(g);
+        free(h);
+        return false;
+    }
+    struct import_alias *entry = &al->items[al->count++];
+    entry->guest = g;
+    entry->guest_len = strlen(g);
+    entry->host = h;
+    entry->host_len = strlen(h);
+    return true;
+}
+
+static bool import_path_exists(sqlite3_stmt *select_path, const char *guest_path) {
+    sqlite3_bind_blob64(select_path, 1, guest_path, strlen(guest_path), SQLITE_TRANSIENT);
+    int rc = sqlite3_step(select_path);
+    sqlite3_reset(select_path);
+    return rc == SQLITE_ROW;
+}
+
+static bool import_host_exists(int root_fd, const char *host_path) {
+    if (host_path[0] == '\0')
+        return true;
+    struct stat st;
+    return fstatat(root_fd, fix_path(host_path), &st, AT_SYMLINK_NOFOLLOW) == 0;
+}
+
+static bool import_next_alias(int root_fd, struct import_alias_list *al,
+        sqlite3 *db, sqlite3_stmt *insert_alias, const char *guest_path,
+        const char *cand, char *host_out, size_t cap, struct fakefsify_error *err_out) {
+    for (int tries = 0; tries < 65536; tries++) {
+        uint64_t seq = al->seq++;
+        int n = snprintf(host_out, cap, "%s.#ish#%llu", cand, (unsigned long long) seq);
+        if (n < 0 || (size_t) n >= cap) {
+            FILL_ERR(ERR_POSIX, ENAMETOOLONG, strerror(ENAMETOOLONG));
+        }
+        if (!import_host_exists(root_fd, host_out)) {
+            if (!import_alias_add(al, guest_path, host_out)) {
+                FILL_ERR(ERR_POSIX, ENOMEM, strerror(ENOMEM));
+            }
+            sqlite3_bind_blob64(insert_alias, 1, guest_path, strlen(guest_path), SQLITE_TRANSIENT);
+            sqlite3_bind_blob64(insert_alias, 2, host_out, strlen(host_out), SQLITE_TRANSIENT);
+            if (sqlite3_step(insert_alias) == SQLITE_ERROR)
+                HANDLE_ERR(db);
+            sqlite3_reset(insert_alias);
+            return true;
+        }
+    }
+    FILL_ERR(ERR_POSIX, EEXIST, strerror(EEXIST));
+}
+
+static bool import_prepare_host_path(int root_fd, struct import_alias_list *al,
+        sqlite3 *db, sqlite3_stmt *select_path, sqlite3_stmt *insert_alias,
+        const char *guest_path, char *cand_out, size_t cand_cap,
+        char *host_out, size_t cap, bool *is_new_out, struct fakefsify_error *err_out) {
+    *is_new_out = false;
+    if (guest_path[0] == '\0' || !al->case_insensitive) {
+        int n = snprintf(host_out, cap, "%s", guest_path);
+        if (n < 0 || (size_t) n >= cap) {
+            FILL_ERR(ERR_POSIX, ENAMETOOLONG, strerror(ENAMETOOLONG));
+        }
+        if (cand_out) {
+            int cn = snprintf(cand_out, cand_cap, "%s", host_out);
+            if (cn < 0 || (size_t) cn >= cand_cap) {
+                FILL_ERR(ERR_POSIX, ENAMETOOLONG, strerror(ENAMETOOLONG));
+            }
+        }
+        return true;
+    }
+    if (import_path_exists(select_path, guest_path)) {
+        import_alias_to_host(al, guest_path, host_out, cap);
+        if (cand_out) snprintf(cand_out, cand_cap, "%s", host_out);
+        return true;
+    }
+    *is_new_out = true;
+    const char *slash = strrchr(guest_path, '/');
+    if (!slash) {
+        FILL_ERR(ERR_POSIX, EINVAL, "invalid archive path");
+    }
+    size_t parent_len = (size_t) (slash - guest_path);
+    char parent_guest[PATH_MAX];
+    if (parent_len >= sizeof(parent_guest)) {
+        FILL_ERR(ERR_POSIX, ENAMETOOLONG, strerror(ENAMETOOLONG));
+    }
+    memcpy(parent_guest, guest_path, parent_len);
+    parent_guest[parent_len] = '\0';
+    char parent_host[PATH_MAX];
+    import_alias_to_host(al, parent_guest, parent_host, sizeof(parent_host));
+    char cand[PATH_MAX];
+    int n = snprintf(cand, sizeof(cand), "%s%s", parent_host, slash);
+    if (n < 0 || (size_t) n >= sizeof(cand)) {
+        FILL_ERR(ERR_POSIX, ENAMETOOLONG, strerror(ENAMETOOLONG));
+    }
+    if (cand_out) {
+        int cn = snprintf(cand_out, cand_cap, "%s", cand);
+        if (cn < 0 || (size_t) cn >= cand_cap) {
+            FILL_ERR(ERR_POSIX, ENAMETOOLONG, strerror(ENAMETOOLONG));
+        }
+    }
+    if (!import_host_exists(root_fd, cand)) {
+        snprintf(host_out, cap, "%s", cand);
+        return true;
+    }
+    return import_next_alias(root_fd, al, db, insert_alias, guest_path, cand, host_out, cap, err_out);
+}
+
+static bool import_ensure_parents(int root_fd, struct import_alias_list *al,
+        sqlite3 *db, sqlite3_stmt *select_path, sqlite3_stmt *insert_alias,
+        sqlite3_stmt *insert_stat, sqlite3_stmt *insert_path,
+        const char *entry_path, struct fakefsify_error *err_out) {
+    char *copy = strdup(entry_path);
+    if (!copy)
+        POSIX_ERR();
+    char *slash = copy;
+    while ((slash = strchr(*slash ? slash + 1 : slash, '/')) != NULL) {
+        *slash = '\0';
+        if (!import_path_exists(select_path, copy)) {
+            char cand_host[PATH_MAX];
+            char parent_host[PATH_MAX];
+            bool is_new = false;
+            if (!import_prepare_host_path(root_fd, al, db, select_path, insert_alias, copy, cand_host, sizeof(cand_host), parent_host, sizeof(parent_host), &is_new, err_out)) {
+                free(copy);
+                return false;
+            }
+            int err = mkdirat(root_fd, fix_path(parent_host), 0777);
+            for (int tries = 0; err < 0 && errno == EEXIST && al->case_insensitive && is_new && tries < 64; tries++) {
+                if (!import_next_alias(root_fd, al, db, insert_alias, copy, cand_host, parent_host, sizeof(parent_host), err_out)) {
+                    free(copy);
+                    return false;
+                }
+                err = mkdirat(root_fd, fix_path(parent_host), 0777);
+            }
+            if (err < 0 && errno != EEXIST) {
+                free(copy);
+                POSIX_ERR();
+            }
+            struct ish_stat dir_stat = {.mode = S_IFDIR | 0755};
+            sqlite3_bind_blob64(insert_stat, 1, &dir_stat, sizeof(dir_stat), SQLITE_TRANSIENT);
+            if (sqlite3_step(insert_stat) == SQLITE_ERROR) {
+                free(copy);
+                HANDLE_ERR(db);
+            }
+            sqlite3_reset(insert_stat);
+            sqlite3_bind_blob64(insert_path, 1, copy, strlen(copy), SQLITE_TRANSIENT);
+            sqlite3_bind_int64(insert_path, 2, sqlite3_last_insert_rowid(db));
+            if (sqlite3_step(insert_path) == SQLITE_ERROR) {
+                free(copy);
+                HANDLE_ERR(db);
+            }
+            sqlite3_reset(insert_path);
+        }
+        *slash = '/';
+    }
+    free(copy);
+    return true;
+}
