+static void alias_cache_clear(struct fakefs_db *fs) {
+    for (size_t i = 0; i < fs->alias_count; i++) {
+        free(fs->aliases[i].guest);
+        free(fs->aliases[i].host);
+    }
+    free(fs->aliases);
+    fs->aliases = NULL;
+    fs->alias_count = 0;
