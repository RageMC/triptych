+    if (!sa || !sb)
+        return false;
+    size_t da = (size_t) (sa - a);
+    size_t db = (size_t) (sb - b);
+    return da == db && memcmp(a, b, da) == 0 && strcasecmp(sa + 1, sb + 1) == 0;
