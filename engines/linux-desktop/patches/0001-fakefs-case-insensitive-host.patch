+static bool alias_rewrite_prefix(const char *path, size_t path_len,
+        size_t from_len, const char *to, size_t to_len,
+        char *out, size_t cap) {
+    size_t tail_len = path_len - from_len;
+    size_t total = to_len + tail_len + 1;
+    if (total > cap)
