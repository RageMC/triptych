+static char *dup_blob(sqlite3_stmt *stmt, int col, size_t *out_len) {
+    const void *p = sqlite3_column_blob(stmt, col);
+    int len = sqlite3_column_bytes(stmt, col);
+    if (len < 0) len = 0;
+    char *s = malloc((size_t) len + 1);
+    if (!s) die("out of memory");
+    if (len > 0 && p) memcpy(s, p, (size_t) len);
+    s[len] = '\0';
+    *out_len = (size_t) len;
+    return s;
+}
+
+static void alias_sync_locked(struct fakefs_db *fs) {
+    if (!fs->case_insensitive || fs->alias_gen == fs->generation)
+        return;
+    alias_cache_clear(fs);
+    size_t cap = 0;
+    while (db_exec(fs, fs->stmt.alias_load)) {
+        if (fs->alias_count == cap) {
+            cap = cap ? cap * 2 : 16;
+            struct fakefs_case_alias *next = realloc(fs->aliases, cap * sizeof(*next));
+            if (!next) die("out of memory");
+            fs->aliases = next;
+        }
+        struct fakefs_case_alias *e = &fs->aliases[fs->alias_count++];
+        e->guest = dup_blob(fs->stmt.alias_load, 0, &e->guest_len);
+        e->host = dup_blob(fs->stmt.alias_load, 1, &e->host_len);
+    }
+    db_reset(fs, fs->stmt.alias_load);
+    fs->alias_gen = fs->generation;
