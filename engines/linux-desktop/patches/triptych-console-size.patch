--- a/fs/tty.c
+++ b/fs/tty.c
@@ -17,6 +17,26 @@
 
 // lock this before locking a tty
 lock_t ttys_lock = LOCK_INITIALIZER;
+static struct winsize_ host_console_size;
+
+void real_tty_set_host_size(unsigned short cols, unsigned short rows) {
+    struct winsize_ size = {.col = cols, .row = rows};
+    dword_t group = 0;
+    lock(&ttys_lock);
+    host_console_size = size;
+    struct tty *tty = real_tty_driver.ttys[1];
+    if (tty) {
+        lock(&tty->lock);
+        if (tty->winsize.col != cols || tty->winsize.row != rows) {
+            tty->winsize = size;
+            group = tty->fg_group;
+        }
+        unlock(&tty->lock);
+    }
+    unlock(&ttys_lock);
+    if (group)
+        send_group_signal(group, SIGWINCH_, SIGINFO_NIL);
+}
 
 struct tty *tty_alloc(struct tty_driver *driver, int type, int num) {
     struct tty *tty = malloc(sizeof(struct tty));
