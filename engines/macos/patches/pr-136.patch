     static dispatch_once_t once;
     dispatch_once(&once, ^{
@@ -31,6 +37,7 @@ static int cursor_scale(void) {
     });
     return defaultScale;
 #else
+    (void)page, (void)width;
     return 1;
 #endif
 }
