diff --git a/ios/Henge/JIT/JITSetupView.swift b/ios/Henge/JIT/JITSetupView.swift
index 7089eee..cd5725b 100644
--- a/ios/Henge/JIT/JITSetupView.swift
+++ b/ios/Henge/JIT/JITSetupView.swift
@@ -282,7 +282,10 @@ struct JITSetupFlow: View {
 
     // MARK: Enable
 
-    private var attached: Bool { jit.attachGeneration > 0 || JITBootstrap.debuggerUsable }
+    /// The same answer Settings' Status shows (JITBootstrap.state): on only once the JIT region is held, not as soon as a
+    /// debugger traces Henge, which inside LiveContainer it does from launch.
+    private var jitState: JITBootstrap.JITState { _ = jit.attachGeneration; return JITBootstrap.state }
+    private var attached: Bool { jitState == .on }
 
     private var enable: some View {
         page(symbol: "bolt.badge.checkmark", title: "Turn on JIT",
@@ -304,6 +307,22 @@ struct JITSetupFlow: View {
                 .padding(16).hengeCard(high: true)
             } else if attached {
                 outcome("JIT is on. a Mac can start.", ok: true)
+                    .accessibilityIdentifier("henge-jit-outcome")
+            } else if jit.error == nil, case .failed(let why) = jitState {
+                outcome(why, ok: false).accessibilityIdentifier("henge-jit-outcome")
+            } else if jit.error == nil, jitState == .claiming {
+                HStack(spacing: 11) {
+                    ProgressView().tint(Theme.accent)
+                    Text("A debugger is attached. Claiming the JIT region…")
+                        .font(.system(size: 14)).foregroundStyle(Theme.text)
+                    Spacer(minLength: 0)
+                }
+                .padding(16).hengeCard(high: true)
+                .task { // a debugger that attached outside Henge's own watch (LiveContainer's, StikDebug's app list) is claimed here
+                    try? await Task.sleep(nanoseconds: 1_000_000_000)
+                    if JITBootstrap.state == .claiming { JITBootstrap.prewarm() }
+                    jit.objectWillChange.send()
+                }
             } else if let error = jit.error {
                 VStack(alignment: .leading, spacing: 10) {
                     outcome(error, ok: false)
diff --git a/ios/Henge/SettingsView.swift b/ios/Henge/SettingsView.swift
index e74fd41..df3dea2 100644
--- a/ios/Henge/SettingsView.swift
+++ b/ios/Henge/SettingsView.swift
@@ -34,11 +34,18 @@ struct SettingsView: View {
         }
     }
 
+    /// Read through the coordinator so an attach or a claim redraws Status (the state itself lives outside it).
+    private var jitState: JITBootstrap.JITState { _ = jit.attachGeneration; return JITBootstrap.state }
+
     var body: some View {
         NavigationStack {
             Form {
                 Section("JIT") {
-                    LabeledContent("Status", value: JITBootstrap.ready ? "On" : "Off")
+                    LabeledContent("Status", value: JITBootstrap.statusText(jitState))
+                        .accessibilityIdentifier("henge-jit-status")
+                    if case .failed(let why) = jitState {
+                        Text(why).font(.footnote).foregroundStyle(.secondary)
+                    }
                     Picker("Method", selection: $jit.method) {
                         ForEach(JITMethod.allCases) { Text($0.title).tag($0) }
                     }
