@@ -284,7 +284,7 @@ final class JITCoordinator: ObservableObject {
             guard let self else { return }
             busy = false
             if attached {
-                status = "JIT is on."
+                status = "The debugger attached."
                 error = nil
                 attachGeneration += 1
                 log("StikDebug attached")
@@ -383,7 +383,7 @@ final class JITCoordinator: ObservableObject {
                 log("built-in JIT failed: \(failure)")
                 showSetup = true
             } else {
-                status = "JIT is on."
+                status = "The debugger attached."
