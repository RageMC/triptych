From: RageMC <24841174+RageMC@users.noreply.github.com>
Date: Sat, 21 Nov 2026 15:32:09 -0500
Subject: [PATCH] JIT: one state for Settings' Status and the setup sheet (on
 only once the region is held)

---
 ios/Henge/HengeApp.swift         |  5 ++++-
 ios/Henge/JIT/JITBootstrap.swift | 34 ++++++++++++++++++++++++++++++++
 ios/Henge/JIT/JITBuiltIn.swift   |  6 +++++-
 ios/Henge/JIT/JITSetup.swift     |  6 +++---
 ios/Henge/JIT/JITSetupView.swift | 21 +++++++++++++++++++-
 ios/Henge/SettingsView.swift     |  9 ++++++++-
 6 files changed, 74 insertions(+), 7 deletions(-)

diff --git a/ios/Henge/HengeApp.swift b/ios/Henge/HengeApp.swift
index 3dc902e..6dbc274 100644
--- a/ios/Henge/HengeApp.swift
+++ b/ios/Henge/HengeApp.swift
@@ -89,7 +89,10 @@ struct RootView: View {
                 catch { return } // going into the background cancels this wait
             }
         }
-        .onChange(of: jit.attachGeneration) { _ in JITBootstrap.prewarm() } // the built-in helper attached
+        .onChange(of: jit.attachGeneration) { _ in // the built-in helper attached
+            JITBootstrap.prewarm()
+            jit.objectWillChange.send() // Status and the setup sheet show the claim's outcome (JITBootstrap.state)
+        }
         .task { // testing only: HENGE_AUTOPILOT
             await Autopilot.run { mac in
                 // A session still on screen (its Mac stopped) is closed first: the same value again would start nothing.
diff --git a/ios/Henge/JIT/JITBootstrap.swift b/ios/Henge/JIT/JITBootstrap.swift
index c3e7397..585bc84 100644
--- a/ios/Henge/JIT/JITBootstrap.swift
+++ b/ios/Henge/JIT/JITBootstrap.swift
@@ -213,6 +213,40 @@ enum JITBootstrap {
         return prewarm()
     }
 
+    /// What Henge's JIT is, for every place that shows it: Settings' Status and the setup sheet read this one answer, so the
+    /// sheet can no longer say "JIT is on" while Status says Off. A debugger tracing Henge on a TXM device is not JIT yet:
+    /// the region is claimed with that debugger's help, and only once it is held can a Mac start. Inside LiveContainer a
+    /// debugger traces Henge from launch, which the sheet used to count as on while Status (rightly) said Off.
+    enum JITState: Equatable {
+        case on                 // the region is held, or this device lets a debugged process make its own
+        case claiming           // a debugger traces Henge; the region has not been claimed yet
+        case failed(String)     // the last claim failed (lastFailure)
+        case off
+    }
+
+    /// The decision behind `state`, on plain values so it can be tested.
+    static func state(ready: Bool, debugged: Bool, traced: Bool, txm: Bool, failure: String?) -> JITState {
+        if ready { return .on }
+        if let failure { return .failed(failure) }
+        if debugged && (traced || !txm) { return .claiming }
+        return .off
+    }
+
+    /// Cheap after the first call (`ready` tries the self-grant once, before iOS 26); logs nothing.
+    static var state: JITState {
+        state(ready: ready, debugged: debuggedFlag, traced: isTraced, txm: deviceEnforcesTXM, failure: lastFailure)
+    }
+
+    /// The Status line in Settings.
+    static func statusText(_ state: JITState) -> String {
+        switch state {
+        case .on: return "On"
+        case .claiming: return "Debugger attached, region not claimed yet"
+        case .failed: return "Off (the JIT region could not be claimed)"
+        case .off: return "Off"
+        }
+    }
+
     /// True once this process has told StikDebug to let go.
     nonisolated(unsafe) static private(set) var detached = false
 
