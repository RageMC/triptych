             fail(2, "Henge's JIT helper (\(identifier)) could not be found: \(error.localizedDescription) "
-                  + "Reinstall Henge.")
+                  + (LiveContainerHost.isHosting
+                     ? "LiveContainer does not register its apps' extensions with iOS: launch Henge from LiveContainer "
+                       + "with JIT (StikDebug), or install it directly instead of inside LiveContainer."
+                     : "Reinstall Henge."))
             return
         }
         guard let data = try? JSONEncoder().encode(request) else {
diff --git a/ios/Henge/JIT/JITSetup.swift b/ios/Henge/JIT/JITSetup.swift
