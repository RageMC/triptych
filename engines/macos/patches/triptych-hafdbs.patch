From b588f0bb4df1832d03a23615981d1dd68d695bb0 Mon Sep 17 00:00:00 2001
From: RageMC <24841174+RageMC@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:04:29 -0500
Subject: [PATCH] FEAT_HAFDBS (Access flag only) behind HvMachine.hafdbs, for
 Windows on Arm

---
 core/machine.h |  1 +
 core/mmu.c     | 12 ++++++++++--
 core/sysreg.c  |  4 ++--
 3 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/core/machine.h b/core/machine.h
index b7633fb..b0cc42b 100644
--- a/core/machine.h
+++ b/core/machine.h
@@ -248,6 +248,7 @@ typedef struct HvMachine {
     uint32_t jit_gen;    /* full flushes so far, as blocks see them (HV_JIT_POISON checks) */
     int gen_checks;
     int trace;           /* print every block entered */
+    int hafdbs;          /* FEAT_HAFDBS, Access flag only (winarm: Windows on Arm needs it); macOS guests keep it off */
     int psci_smc;        /* PSCI over SMC too (EDK2 + Windows on the winarm board: no EL3, so the HVC handler answers) */
     int log;             /* 1: unknown sysregs, undefined instructions, unmapped accesses; 2: also every exception */
     int slow_mem;        /* tests: send every load and store through hv_mem_emulate */
diff --git a/core/mmu.c b/core/mmu.c
index 337259f..cebc788 100644
--- a/core/mmu.c
+++ b/core/mmu.c
@@ -111,8 +111,16 @@ void hv_mmu_walk(HvCpu *cpu, uint64_t va, HvAccess acc, int el, HvWalk *out) {
         out->pa = (desc & OA_MASK & ~(size - 1)) | (va & (size - 1));
         out->attr = (cpu->mair_el1 >> (((desc >> 2) & 7) * 8)) & 0xff;
         if (!(desc & (1u << 10))) {
-            out->fsc = HV_FSC_ACCESS(level);
-            return;
+            /* FEAT_HAFDBS (Access flag only): with TCR_EL1.HA the walk sets AF itself, atomically, as hardware does.
+               Windows on Arm relies on this. Without HA, or if the descriptor changed under us, it's an Access fault. */
+            HvRam *r = cpu->m->hafdbs && ((tcr >> 39) & 1) ? ram_of(cpu->m, base + idx * 8) : NULL;
+            uint64_t *p = r ? (uint64_t *)(void *)(r->host + (base + idx * 8 - r->pa)) : NULL;
+            uint64_t want = desc | (1u << 10);
+            if (!p || !__atomic_compare_exchange_n(p, &desc, want, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+                out->fsc = HV_FSC_ACCESS(level);
+                return;
+            }
+            desc = want;
         }
         int ap = (desc >> 6) & 3;
         int uxn = ((desc >> 54) & 1) | uxn_table;
diff --git a/core/sysreg.c b/core/sysreg.c
index a4fe1b2..67e7b23 100644
--- a/core/sysreg.c
+++ b/core/sysreg.c
@@ -19,7 +19,7 @@
 #define ID_AA64ISAR0 0x0011100110212120ull /* AES+PMULL, SHA1, SHA2/512, CRC32, LSE, RDM, SHA3, DotProd, FHM, FlagM */
 #define ID_AA64ISAR1 0x0000001110211011ull /* DPB, PAuth (no-op), JSCVT, FCMA, LRCPC2, PACGA, FRINTTS, SB */
 #define ID_AA64MMFR0 0x0000000000100025ull /* 48-bit PA, 16-bit ASID, 4K/16K/64K granules */
-#define ID_AA64MMFR1 0x0000000000111000ull /* HPDS, LOR, PAN */
+#define ID_AA64MMFR1 0x0000000000111000ull /* HPDS, LOR, PAN (+ HAFDBS=1 on machines with hafdbs) */
 #define ID_AA64DFR0  0x0000000000000006ull /* Armv8 debug, no PMU */
 #define MIDR         0x611f0220ull         /* Apple; a configuration constant for now */
 #define CTR_EL0      0x9444c004ull         /* 64-byte lines, PIPT I-cache, IDC */
@@ -121,7 +121,7 @@ static int read_reg(HvCpu *cpu, uint32_t reg, uint64_t *v) {
     case R(3, 0, 0, 6, 0): *v = ID_AA64ISAR0; return 0;
     case R(3, 0, 0, 6, 1): *v = ID_AA64ISAR1; return 0;
     case R(3, 0, 0, 7, 0): *v = ID_AA64MMFR0; return 0;
-    case R(3, 0, 0, 7, 1): *v = ID_AA64MMFR1; return 0;
+    case R(3, 0, 0, 7, 1): *v = ID_AA64MMFR1 | (cpu->m->hafdbs ? 1 : 0); return 0;
     case R(3, 3, 0, 0, 1): *v = CTR_EL0; return 0;
     case R(3, 3, 0, 0, 7): *v = 4; return 0;                             /* DCZID: 64-byte DC ZVA */
     case R(3, 1, 0, 0, 1): *v = CLIDR; return 0;
-- 
