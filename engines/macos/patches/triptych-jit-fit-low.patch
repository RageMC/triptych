+/* Triptych: the largest free run below HENGE_JIT_LOW_LIMIT, from 0x100000000 (where the app's image starts) up.
+   The debugger's region is placed first-fit, so a request no gap down here can hold lands above the limit, where
+   generated code never runs (seen on an iPad16,6 with iPadOS 27.2 under LiveContainer: gaps of 394, 936 and 264 MiB,
+   a 1536 MiB request placed at 0x7000b04000 four times in a row). */
+static uint64_t henge_ios_jit_largest_low_gap(void)
+{
+    mach_vm_address_t addr = 0, prev_end = 0x100000000ull;
+    uint64_t best = 0;
+    for (int i = 0; i < 4096; i++) {
+        vm_size_t size = 0;
+        vm_address_t a = (vm_address_t)addr;
+        natural_t depth = 0;
+        struct vm_region_submap_info_64 info;
+        mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+        if (vm_region_recurse_64(mach_task_self(), &a, &size, &depth, (vm_region_recurse_info_t)&info, &count) != KERN_SUCCESS) {
+            a = (vm_address_t)HENGE_JIT_LOW_LIMIT; size = 0;
+        }
+        uint64_t lo = prev_end, hi = (uint64_t)a < HENGE_JIT_LOW_LIMIT ? (uint64_t)a : HENGE_JIT_LOW_LIMIT;
+        if (hi > lo && hi - lo > best) best = hi - lo;
+        if ((uint64_t)a >= HENGE_JIT_LOW_LIMIT || size == 0) break;
+        if (a + size > prev_end) prev_end = a + size;
+        addr = a + size;
+    }
+    return best;
+}
+
+/* What to ask the debugger for: the size wanted, or the largest that fits a low gap (16 MiB steps, 256 MiB at least). */
+static size_t henge_ios_jit_fit_low(size_t bytes)
+{
+    uint64_t gap = henge_ios_jit_largest_low_gap() & ~((16ull << 20) - 1);
+    if (gap >= bytes) return bytes;
+    return gap >= (256ull << 20) ? (size_t)gap : 0;
+}
