diff --git a/tl/loader/tl_bundle.m b/tl/loader/tl_bundle.m
index 9583ca17..ae07aa40 100644
--- a/tl/loader/tl_bundle.m
+++ b/tl/loader/tl_bundle.m
@@ -13,12 +13,35 @@
 
 /* The app's own code asking (objc_msgSend tail-calls this, so the return address is the caller's) gets the app's
    bundle; anything else, the host included (Henge reads its own resources and build all launch), the host's. */
-static NSBundle *main_bundle(id self, SEL _cmd) {
-    void *caller = __builtin_return_address(0);
+static NSBundle *guest_bundle_for(void *caller) {
     int ns = tl_ns_of_address(caller);
     if (ns > 0 && ns < 64 && g_ns_bundles[ns]) return g_ns_bundles[ns];
     if (g_bundle && (g_for_everyone || tl_image_containing(caller))) return g_bundle;
-    return ((NSBundle * (*)(id, SEL))g_host_main_bundle)(self, _cmd);
+    return nil;
+}
+
+static NSBundle *main_bundle(id self, SEL _cmd) {
+    NSBundle *b = guest_bundle_for(__builtin_return_address(0));
+    return b ?: ((NSBundle * (*)(id, SEL))g_host_main_bundle)(self, _cmd);
+}
+
+/* CFBundleGetMainBundle for the app's own code: the loader binds the app's import of it here (see host_symbol). The
+   CFBundle of the bundle main_bundle() would give is made once and kept, as the real call's is. */
+void *tl_cf_main_bundle(void) {
+    NSBundle *b = guest_bundle_for(__builtin_return_address(0));
+    if (!b) return (void *)CFBundleGetMainBundle();
+    static NSMutableDictionary *made;
+    @synchronized([NSBundle class]) {
+        if (!made) made = [NSMutableDictionary new];
+        NSString *key = b.bundlePath;
+        CFBundleRef cf = (__bridge CFBundleRef)made[key];
+        if (!cf) {
+            cf = CFBundleCreate(NULL, (__bridge CFURLRef)b.bundleURL);
+            if (!cf) return (void *)CFBundleGetMainBundle();
+            made[key] = (__bridge_transfer id)cf;
+        }
+        return (void *)cf;
+    }
 }
 
 /* Processes started inside the app (processes as threads) each have their own app bundle (a helper's .app). */
@@ -44,7 +67,6 @@ int tl_adopt_main_bundle(const char *app_path) {
         Method m = class_getClassMethod([NSBundle class], @selector(mainBundle));
         IMP old = method_setImplementation(m, (IMP)main_bundle);
         if (old != (IMP)main_bundle) g_host_main_bundle = old;
-        /* Not yet: CFBundleGetMainBundle() still answers the host's bundle (LiveContainer rewrites the CFBundle). */
         return 0;
     }
 }
