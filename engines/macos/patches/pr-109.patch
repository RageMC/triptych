+    /* The pointer's place is in the display mode's pixels; a scaled resolution's frame is smaller than the mode. */
+    uint32_t mw = w, mh = h;
+    hv_pvg_lite_mode(&mw, &mh);
+    if (!mw || !mh) mw = w, mh = h;
