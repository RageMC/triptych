From e7190561ad1620259bde21eced7fca3f38eded31 Mon Sep 17 00:00:00 2001
From: Triptych <triptych@localhost>
Date: Sun, 15 Nov 2026 02:20:29 -0500
Subject: [PATCH] Enable dual-mapped RW/RX JIT arenas on iOS Simulator
 (husk-tl-xmem, husk-jit-arena)

---
 src/translation-layer-next/husk-jit-arena.c | 4 ++--
 src/translation-layer-next/husk-tl-xmem.c   | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/translation-layer-next/husk-jit-arena.c b/src/translation-layer-next/husk-jit-arena.c
index 1f0e38e..df812fe 100644
--- a/src/translation-layer-next/husk-jit-arena.c
+++ b/src/translation-layer-next/husk-jit-arena.c
@@ -60,7 +60,7 @@ bool husk_jit_arena_open_region(uint8_t *rw, uint8_t *rx, size_t size, size_t ce
 #if defined(__APPLE__)
 typedef struct { uint8_t *rw_addr, *rx_addr; size_t size; } arena_dual_mapping;
 
-#if TARGET_OS_OSX
+#if TARGET_OS_OSX || TARGET_OS_SIMULATOR
 /* A Mac: read+execute pages plus a writable alias of them, the layout StikDebug's region has on the
  * phone. Needs a process without the hardened runtime (as Husk's Mac tools are); MAP_JIT is not used
  * because a MAP_JIT region cannot be vm_remap'd and the phone has no MAP_JIT either. */
@@ -82,7 +82,7 @@ static bool open_mac(size_t bytes, uint8_t **rw, uint8_t **rx, char *err, size_t
 bool husk_jit_arena_open(size_t region_bytes, size_t ceiling_bytes, char *err, size_t errlen)
 {
     if (husk_jit_arena_is_open()) return true;
-#if defined(__APPLE__) && !TARGET_OS_OSX
+#if defined(__APPLE__) && !TARGET_OS_OSX && !TARGET_OS_SIMULATOR
     (void)region_bytes;
     arena_dual_mapping *(*get)(void) = (arena_dual_mapping *(*)(void))dlsym(RTLD_DEFAULT, "husk_ios_jit_get_mapping");
     arena_dual_mapping *m = get ? get() : NULL;
diff --git a/src/translation-layer-next/husk-tl-xmem.c b/src/translation-layer-next/husk-tl-xmem.c
index e8c1245..00f3ffb 100644
--- a/src/translation-layer-next/husk-tl-xmem.c
+++ b/src/translation-layer-next/husk-tl-xmem.c
@@ -119,7 +119,7 @@ static bool grant_self(size_t host_bytes, char *err, size_t errlen)
 }
 #endif
 
-#if defined(__APPLE__) && !TARGET_OS_OSX
+#if defined(__APPLE__) && !TARGET_OS_OSX && !TARGET_OS_SIMULATOR
 /* The loader retargets code at the writable view with adrp (+-4 GiB). A region whose writable alias the kernel placed anywhere
  * (VM_FLAGS_ANYWHERE: hundreds of GiB away on iOS 27) gets a second alias of the same pages next to the executable view: a local
  * vm_remap, which needs no debugger. Free addresses after the region, then before it, in 16 MiB steps out to 2 GiB. */
-- 
