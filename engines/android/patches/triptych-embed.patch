diff --git a/src/app/Husk/HuskApp.swift b/src/app/Husk/HuskApp.swift
index da6686e..12031d0 100644
--- a/src/app/Husk/HuskApp.swift
+++ b/src/app/Husk/HuskApp.swift
@@ -1,5 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 import SwiftUI
+import UIKit
 
 /// Which way the app may turn. The app follows the device, except while a landscape game is on screen:
 /// Geometry Dash is a landscape game, and a fixed-size surface cannot follow a rotation.
@@ -54,16 +55,65 @@ final class HuskAppDelegate: NSObject, UIApplicationDelegate {
     }
 }
 
+#if !TRIPTYCH_EMBED
 @main
 struct HuskApp: App {
     @UIApplicationDelegateAdaptor(HuskAppDelegate.self) private var appDelegate
 
-    init() {
+    init() { HuskBoot.run() }
+
+    var body: some Scene {
+        WindowGroup { HuskRootView() }
+    }
+}
+#endif
+
+private final class HuskBundleToken {}
+
+extension Bundle {
+    static let husk = Bundle(for: HuskBundleToken.self)
+
+    static func huskResourcePath(_ name: String, ofType ext: String? = nil, inDirectory sub: String? = nil) -> String? {
+        husk.path(forResource: name, ofType: ext, inDirectory: sub)
+            ?? main.path(forResource: name, ofType: ext, inDirectory: sub)
+    }
+
+    static func huskSubdirectory(_ name: String) -> String? {
+        for bundle in [husk, main] {
+            if let p = bundle.resourcePath.map({ $0 + "/" + name }),
+               FileManager.default.fileExists(atPath: p) {
+                return p
+            }
+        }
+        return nil
+    }
+
+    static func huskPrivateFrameworkFile(_ relative: String) -> String {
+        for bundle in [main, husk] {
+            if let fw = bundle.privateFrameworksPath {
+                let candidate = fw + "/" + relative
+                if FileManager.default.fileExists(atPath: candidate) { return candidate }
+            }
+        }
+        return (main.privateFrameworksPath ?? "") + "/" + relative
+    }
+}
+
+/// Start-up work, shared by the Husk app and by hosts that embed Husk
+/// (Triptych loads HuskRuntime.framework as a dynamic library and calls the C entry points below).
+@MainActor
+enum HuskBoot {
+    private static var done = false
+
+    static func run() {
+        if done { return }
+        done = true
         // Order matters. HuskLog redirects stderr, so anything that logs before
         // this point is lost -- and the JIT path is exactly what we cannot afford
         // to lose the first line of.
         HuskLog.start()
         HuskLog.logFootprint("app-launch")
+        _ = Downloads.shared
         // Before anything asks a debugger for anything: was this process already marked as debugged (a jailbreak that allows JIT in apps)?
         JITBootstrap.noteLaunchState()
         HuskLog.log("jit", "debugged at launch: \(JITBootstrap.debuggedAtLaunch); TrollStore install: \(JITBootstrap.isInstalledWithTrollStore); jailbreak: \(JITBootstrap.isJailbroken); can grant its own JIT: \(JITBootstrap.canGrantOwnJIT)")
@@ -84,17 +134,48 @@ struct HuskApp: App {
         // Game controllers, for the games the native runtime runs.
         Task { @MainActor in HuskGamepads.shared.start() }
     }
+}
 
-    var body: some Scene {
-        WindowGroup {
-            ContentView()
-                // An APK shared to Husk, or opened in it from Files.
-                .onOpenURL { url in
-                    // husk://open_app?unique_identifier=… from a Home Screen clip; anything else may be a shared APK
-                    if GameLink.handle(url) { return }
-                    if SigningCertificate.shared.handle(url) { return }   // husk://certificate from SideStore / AltStore
-                    if !AppClip.handle(url) { IncomingFiles.shared.receive(url) }
-                }
-        }
+struct HuskRootView: View {
+    var body: some View {
+        ContentView()
+            // An APK shared to Husk, or opened in it from Files.
+            .onOpenURL { url in
+                HuskBoot.handleURL(url)
+            }
+    }
+}
+
+extension HuskBoot {
+    @discardableResult
+    static func handleURL(_ url: URL) -> Bool {
+        // husk://open_app?unique_identifier=… from a Home Screen clip; anything else may be a shared APK
+        if GameLink.handle(url) { return true }
+        if SigningCertificate.shared.handle(url) { return true }   // husk://certificate from SideStore / AltStore
+        if AppClip.handle(url) { return true }
+        IncomingFiles.shared.receive(url)
+        return true
+    }
+}
+
+// MARK: - Embedding (Triptych)
+
+/// Returns a retained UIViewController that shows Husk. Runs the start-up work once.
+@_cdecl("husk_embed_make_root")
+public func husk_embed_make_root() -> UnsafeMutableRawPointer {
+    MainActor.assumeIsolated {
+        HuskBoot.run()
+        let vc = UIHostingController(rootView: HuskRootView())
+        return Unmanaged.passRetained(vc as UIViewController).toOpaque()
+    }
+}
+
+/// Hands a URL (husk://…, a shared .apk) to Husk. Returns 1 if it was used.
+@_cdecl("husk_embed_open_url")
+public func husk_embed_open_url(_ cstr: UnsafePointer<CChar>) -> Int32 {
+    guard let url = URL(string: String(cString: cstr)) else { return 0 }
+    return MainActor.assumeIsolated {
+        HuskBoot.run()
+        return HuskBoot.handleURL(url) ? 1 : 0
     }
 }
