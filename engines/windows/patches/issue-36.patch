+/* bcd-games #36: the game releases a texture once its fence says the GPU is past it, but Metal's command buffer teardown
+ * (IOGPUMetalCommandBufferStorageReset) runs later and still retains it. Texture objects go on the ml1148 list and are released
+ * once two more command buffers have completed, like heaps. Releases at once if the list cannot grow. cfg tex-defer = 0 restores
+ * the immediate release. */
+static void mad_release_after_gpu(struct mad_device *d, obj_handle_t o) {
+    static int on = -1; int queued = 0;
+    if (!o) return;
+    if (on < 0) on = mad_cfg_int_pe("tex-defer", 1) ? 1 : 0;
+    if (on && d) {
+        EnterCriticalSection(&d->heap_lock);
+        if (mad_grow((void **)&d->mhret, &d->mhret_cap, d->nmhret + 1, sizeof *d->mhret)) {
+            d->mhret[d->nmhret].heap = 0; d->mhret[d->nmhret].mem = NULL; d->mhret[d->nmhret].obj = o;
+            d->mhret[d->nmhret].serial = (UINT64)d->gpu_serial; d->nmhret++; queued = 1;
+        }
+        LeaveCriticalSection(&d->heap_lock);
+    }
+    if (!queued) NSObject_release(o);
+}
